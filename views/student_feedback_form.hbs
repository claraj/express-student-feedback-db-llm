    <div class="header bg-secondary-subtle mb-4 p-4 rounded-3 text-center">
        <h1>Please provide feedback. You may do so anonymously.</h1>
    </div>

    <div class="row">

        <div class="col-md-5">  
            <h2>Instructions</h2>

            <p>As one of our students, your thoughts, feedback and comments are important to us.</p>
            <p>Please send them using this form.</p>
            <p>If you would like us to follow up with you, include your contact information.</p>
            <p>Your feedback will be categorized and sent to the most appropriate department using a LLM.</p>
            <p>If you prefer to submit your feedback in other ways, you can email 
                <a href="mailto:feedback@minneapolis.edu">feedback@minneapolis.edu</a>  
                or talk to your academic advisor, councellor, faculty members, or other college staff.</p>
        </div>   <!-- end of first instructions col div -->

        <div class="col-md-7">
            <form id="feedback-form" method="POST" action="/submit-feedback">

                <label class="form-label" for="name">Name</label>
                <input class="form-control" id="name" name="name">
                <br>

                <label class="form-label" for="email">email</label>
                <input class="form-control" id="email" type="email" name="email">
                <br>

                <label class="form-label" for="comments">Comments</label>
                <textarea class="form-control" id="comments" name="comments" required></textarea>
                <br>

                <p class="mx-2">Are you a current student?</p>

                <div class="form-check">
                    <input class="form-check-input" id="yes" type="radio" value="yes" name="isCurrentStudent">
                    <label class="form-check-label" for="yes">Yes</label>
                </div>
                
                <div class="form-check">
                    <input class="form-check-input" id="no" type="radio" value="no" name="isCurrentStudent">
                    <label class="form-check-label" for="no">No</label>
                </div>
                <br>

                <input id="submit-button" class="btn btn-primary" type="submit">

            </form>
        </div>  <!-- end of second form col div -->

    </div>  <!-- end of the row div that contains both columns -->

<script>

    let feedbackForm = document.querySelector('#feedback-form')
    let feedbackSubmitButton = document.querySelector('#submit-button')

    // Ensure button is enabled and says "Submit" when the page is loaded
    window.addEventListener('pageshow', function() {
    feedbackSubmitButton.disabled = false
    feedbackSubmitButton.value = "Submit"
    })

    // Disable button and change button text to "Submitting..." when the user 
    // has entered valid data in the form and clicked the submit button 
    feedbackForm.addEventListener('submit', function() {
        feedbackSubmitButton.value = "Submitting..."
        feedbackSubmitButton.disabled = true
    })
    
</script>